<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="422dp"
        android:layout_height="678dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/textbox"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/closechrge"
            android:layout_width="49dp"
            android:layout_height="48dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="200dp"
           />


        <TextView
            android:layout_width="276dp"
            android:layout_height="164dp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="0dp"
            android:text="The time limit of the fund has expired, you must withdraw all the balance of the fund and delete it."
            android:textColor="#EAF1EE"
            android:textSize="25sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ok"
            style="@style/MyBottomAppBar"
            android:layout_width="139dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="125dp"
            android:text="Ok"
            android:textColor="@color/greenK" />


    </LinearLayout>


</RelativeLayout>