<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/daushboard_scene"
    android:id="@+id/dashbord">

    <RelativeLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/greenM"
        app:layoutDescription="@xml/daushboard_xml_constraintlayout_scene">

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="65dp"
            android:layout_height="70dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="350dp"
            android:background="@android:drawable/checkbox_off_background"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/charge"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:background="@android:drawable/ic_menu_add"
            android:layout_marginTop="350dp"
            android:layout_marginStart="30dp"
            android:textAlignment="center"
            tools:ignore="MissingConstraints" />

        <ImageButton
            android:id="@+id/transfer"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:layout_marginStart="120dp"
            android:layout_marginTop="350dp"
            android:background="@android:drawable/ic_menu_send"/>

        <ImageButton
            android:id="@+id/cotactmanage"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:layout_marginStart="200dp"
            android:layout_marginTop="350dp"
            android:background="@android:drawable/ic_menu_my_calendar" />

        <ImageButton
            android:id="@+id/funds"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:layout_marginStart="290dp"
            android:layout_marginTop="350dp"
            android:background="@drawable/fund" />


        <ImageButton
            android:id="@+id/requestButton"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:layout_marginStart="290dp"
            android:layout_marginTop="550dp"
            android:background="@android:drawable/stat_notify_chat" />

        <ImageButton
            android:id="@+id/traButton"
            android:layout_width="62dp"
            android:layout_height="70dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="550dp"
            android:background="@android:drawable/ic_menu_rotate" />


        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="297dp"
            android:layout_height="136dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="50dp"
            android:background="@android:drawable/dialog_holo_dark_frame"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/accountBalunce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:layout_marginStart="70dp"
            android:text="$ 0"
            android:textSize="20dp"
            android:textColor="@color/white"/>


        <TextView
            android:id="@+id/chargeB"
            android:layout_width="118dp"
            android:layout_height="61dp"
            android:layout_marginTop="430dp"
            android:text="Charg"
            android:textSize="20dp"
            android:layout_marginStart="35dp"
            android:textStyle="bold"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="278dp"
            android:layout_height="110dp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="200dp"
            android:background="@color/design_default_color_secondary_variant"
            tools:ignore="MissingConstraints" />


        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="468dp"
            android:layout_height="114dp"
            android:layout_marginTop="680dp"
            android:background="@color/greenB"
            tools:ignore="MissingConstraints" />
    </RelativeLayout>
</androidx.constraintlayout.motion.widget.MotionLayout>