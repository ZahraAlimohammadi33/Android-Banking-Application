<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bbb"
    android:id="@+id/request_page"
    app:layoutDescription="@xml/request_page_scene">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/request_box"
        android:layout_width="match_parent"
        android:layout_height="471dp"
        android:layout_marginStart="40dp"
        android:background="@drawable/request"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/request_text"
        android:layout_width="327dp"
        android:layout_height="204dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="150dp"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/anwser_box"
        android:layout_width="376dp"
        android:layout_height="320dp"
        android:layout_marginTop="340dp"
        android:background="@drawable/anwser"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/awnser_text"
        android:layout_width="282dp"
        android:layout_height="147dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="438dp"
        android:text=""/>

    <EditText
        android:id="@+id/request_edit_text"
        android:layout_width="329dp"
        android:layout_height="67dp"
        android:layout_marginTop="700dp"
        android:layout_marginStart="20sp"
        android:hint="Enter your request here . ."/>



    <Button
        android:id="@+id/send_request"
        style="@style/traBottomAppBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="340dp"
        android:layout_marginTop="700dp"
        android:text="Send"
        android:textColor="@color/white"
        android:textSize="20sp" />



</RelativeLayout>