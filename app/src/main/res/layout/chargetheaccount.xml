<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="422dp"
        android:layout_height="678dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/textbox"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/closechrge"
            android:layout_width="49dp"
            android:layout_height="48dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="200dp"
            android:background="@android:drawable/ic_notification_clear_all" />


        <TextView
            android:layout_width="479dp"
            android:layout_height="46dp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="0dp"
            android:text="Charge the account"
            android:textColor="#EAF1EE"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="479dp"
            android:layout_height="37dp"
            android:layout_marginStart="118dp"
            android:layout_marginTop="3dp"
            android:text="Enter the amount"
            android:textColor="#C7E3E0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/amount"
            android:layout_width="231dp"
            android:layout_height="49dp"
            android:layout_marginStart="85dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/edittext"
            android:hint="   $"
            android:inputType="number" />

        <Button
            android:id="@+id/setcharge"
            style="@style/MyBottomAppBar"
            android:layout_width="139dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="125dp"
            android:layout_marginTop="15dp"
            android:text="Continue"
            android:textColor="@color/greenK" />


    </LinearLayout>


</RelativeLayout>